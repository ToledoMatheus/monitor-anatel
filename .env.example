# Copie este arquivo para .env e preencha. Carregue antes de rodar:
#   export $(grep -v '^#' .env | xargs)   # Linux/Mac
# Ou use python-dotenv se preferir.

# SMTP para envio do relatorio. Exemplos:
#   Gmail:          smtp.gmail.com / porta 587 / use "senha de app" (nao a senha da conta)
#   Outlook 365:    smtp.office365.com / 587
#   Servidor proprio da empresa: pergunte ao TI

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=senha-de-app-de-16-caracteres
EMAIL_FROM=seu-email@gmail.com
EMAIL_TO=voce@empresa.com,colega@empresa.com
EMAIL_SUBJECT_PREFIX=[Monitor Anatel]

# Caminho do banco SQLite (opcional)
ANATEL_DB=anatel_state.sqlite3

# Envia email mesmo quando nao houver mudancas? (0 = nao, 1 = sim)
SEND_EMAIL_IF_NO_CHANGES=0
